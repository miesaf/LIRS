# LIRS runs on PHP 8.5, whatever the PHP version of the rest of the site.
<FilesMatch "\.php$">
	SetHandler application/x-lsphp85
</FilesMatch>

Options -Indexes

# Credentials, logs, SQL files, notes and the Bower manifest are never served.
<FilesMatch "^(config(\.example)?\.php|connectDB\.php|error_log|.*\.sql|.*\.md|LICENSE.*|bower\.json)$">
	Require all denied
</FilesMatch>
